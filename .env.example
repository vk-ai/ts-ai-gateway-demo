# Server
PORT=3000

# LLM provider: "mock" (default, offline) or "openai"
LLM_PROVIDER=mock

# Required only when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# RAG: max chunks to retrieve
RAG_TOP_K=3

# Optional provider fallback chain (unset = single provider as above).
# Ordered, comma-separated: openai | mock | flaky. openai is skipped without a key.
# LLM_FALLBACKS=openai,mock
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible server
# LLM_MAX_RETRIES=2
# LLM_TIMEOUT_MS=15000
# LLM_BACKOFF_BASE_MS=250
# LLM_BACKOFF_MAX_MS=4000
# LLM_MAX_RETRY_AFTER_MS=10000
# Deterministic faults for the `flaky` provider (consumed one per call, then ok):
# FLAKY_FAULTS=429:2,503,timeout,drop@3

# Optional per-API-key quotas (unset = off). Callers send x-api-key.
# KEY_RPM=5
# KEY_BURST=5
# KEY_TOKENS_PER_WINDOW=4000
# KEY_WINDOW_MS=60000
# KEY_LIMITS={"free-key":{"requestsPerMinute":1,"tokensPerWindow":1500}}
